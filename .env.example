# Stack de testes de integração (docker-compose.yml). Copie para .env (não versionado).
# Valores de desenvolvimento local: não use em ambientes compartilhados.
SUPERSET_IMAGE=apachesuperset.docker.scarf.sh/apache/superset
SUPERSET_VERSION=6.1.0
SUPERSET_TEST_PORT=8089
SUPERSET_SECRET_KEY=troque-esta-chave-local
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_LOAD_EXAMPLES=0

POSTGRES_VERSION=16
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=testes
