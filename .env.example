# Integration test stack (docker-compose.yml). Copy to .env (not versioned).
# Local development values: do not use in shared environments.
SUPERSET_IMAGE=apachesuperset.docker.scarf.sh/apache/superset
SUPERSET_VERSION=6.1.0
SUPERSET_TEST_PORT=8089
SUPERSET_SECRET_KEY=change-this-local-key
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_LOAD_EXAMPLES=0

POSTGRES_VERSION=16
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tests
